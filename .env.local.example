# Google Analytics — get from analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend email API key — get from resend.com (free tier available)
# Without this, form submissions are logged to console only
RESEND_API_KEY=re_xxxxxxxxxxxx

# Google Sheet webhook URL — Apps Script Web App deployment URL (see docs/google-apps-script.gs)
# Without this, form submissions are not logged to a sheet
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxxxxxx/exec
