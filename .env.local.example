# Google Analytics — get from analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend email API key — get from resend.com (free tier available)
# Without this, form submissions are logged to console only
RESEND_API_KEY=re_xxxxxxxxxxxx

# Google Sheets logging — service account credentials (see docs/google-sheets-setup.md)
# Without these, form submissions are not logged to a sheet
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQI...\n-----END PRIVATE KEY-----\n"
